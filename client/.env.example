# sarvam-pipecat-demo client - environment (Vite; copy to .env.local to override)

# Transport: "smallwebrtc" (default, straight to the local dev runner) or "daily" (the runner
# creates a Daily room; the bot needs DAILY_API_KEY in server/.env).
VITE_TRANSPORT=smallwebrtc

# The bot's start endpoint. The default goes through the Vite dev proxy to http://localhost:7860
# (see vite.config.ts); set an absolute URL ending in /start to reach a runner elsewhere. The
# Sarvam API key never goes here: it stays in the bot.
VITE_START_URL=/start

# Only for a bot on Pipecat Cloud with VITE_TRANSPORT=daily: a *public* API key (browser-safe).
# VITE_PCC_API_KEY=
